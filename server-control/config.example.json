{
  "bind_host": "0.0.0.0",
  "bind_port": 8098,
  "auth": {
    "password_env": "GVT_SERVER_API_PASSWORD",
    "token_ttl_seconds": 86400
  },
  "runtime": {
    "root_dir": "/root/qemu_cmd/multivm",
    "state_file": "/run/gvt-cloud-server/state.json",
    "outputd_socket": "/run/gvt-outputd.sock",
    "outputd_status": "/run/gvt-outputd.status",
    "host_version": "gvt-cloud-server-mvp",
    "log_tail_lines": 200,
    "log_max_bytes": 65536
  },
  "desktops": [
    {
      "id": "vm1",
      "name": "Windows 10 VM1",
      "spice_port": 5900,
      "input_port": 5905,
      "video_port": 5004,
      "audio_port": 5900,
      "resolution": "1024x768",
      "overlay": "/root/qemu_cmd/multivm/win10-vm1.qcow2",
      "pid_file": "/root/qemu_cmd/multivm/vm1.pid",
      "log_file": "/root/qemu_cmd/multivm/vm1.log",
      "tap": "tap-win10a",
      "mac": "52:54:00:10:01:88"
    },
    {
      "id": "vm2",
      "name": "Windows 10 VM2",
      "spice_port": 5901,
      "input_port": 5906,
      "video_port": 5008,
      "audio_port": 5901,
      "resolution": "1024x768",
      "overlay": "/root/qemu_cmd/multivm/win10-vm2.qcow2",
      "pid_file": "/root/qemu_cmd/multivm/vm2.pid",
      "log_file": "/root/qemu_cmd/multivm/vm2.log",
      "tap": "tap-win10b",
      "mac": "52:54:00:10:02:88"
    }
  ]
}
