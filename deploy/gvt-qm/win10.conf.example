# GVT QEMU VM config.
# Install as /etc/gvt-qm/win10.conf, then run:
#   gvt-qm start win10

QEMU_DIR=/root/qemu_cmd
QEMU_BIN=/usr/local/src/project/qemu/build/qemu-system-x86_64

VM_DISK=/root/qemu_cmd/win10-gvtg.qcow2
VGPU_UUID=e582c6f5-e5cd-4a8e-9443-55a013e9f193
RENDER_NODE=/dev/dri/renderD128

TAP_IF=tap-win10
BR_IF=br0
MAC=52:54:00:10:00:88

VCPUS=4
MEMORY_MIB=4096

# Client connects to this control TCP port. QEMU sends video RTP on the same
# numeric UDP port after the client asks it to start streaming.
VIDEO_PORT=5004
SPICE_PORT=5900
INPUT_PORT=5905
CODEC=h265

QEMU_LOG=/root/qemu_cmd/win10-gvt-stream-manual.log
PID_FILE=/root/qemu_cmd/win10-gvt-stream-manual.pid
MONITOR_SOCK=/root/qemu_cmd/win10-gvt-stream-monitor.sock
QMP_SOCK=/root/qemu_cmd/win10-gvt-stream-qmp.sock

CAPTURE_MS=17
IDLE_CAPTURE_MS=17
IDLE_AFTER_MS=0
IDLE_PROBE_MS=0

# Experimental low-bandwidth path. When enabled, QEMU reads back frames for
# dirty-region classification, skips static frames, and lets streamd lower the
# VAAPI encoder bitrate for small dirty regions. Leave disabled for baseline.
LOW_BANDWIDTH=0
# ROI mode encodes only the dirty rect for partial frames. It requires a
# client-side compositor and will not render correctly in the current plain RTP
# viewer, so keep disabled unless testing the ROI path directly.
LOW_BANDWIDTH_ROI=0
DIRTY_BLOCK_SIZE=16
DIRTY_PIXEL_DELTA=8
DIRTY_PARTIAL_MAX_PPM=150000
# Sparse changes spread across a large bounding rect are sent as full frames to
# avoid stale ROI patches leaving visible trails.
DIRTY_PARTIAL_RECT_MAX_PPM=180000
DIRTY_GLOBAL_MIN_PPM=350000
DIRTY_GLOBAL_BURST_FRAMES=2
# After a click/key/wheel input, keep full-frame mode briefly so stale ROI
# decode/control latency cannot leave visible trails.
INPUT_REFRESH_FRAMES=30

ENCODE_FPS=59
ENCODE_BITRATE=18000
# ENCODE_STILL_BITRATE=6300
ENCODE_KEYINT=59
RTP_MTU=1400

# The encoder is always the standalone gvt-streamd process. QEMU only forwards
# scanout DMABUF fds to this socket.
# GVT_STREAMD_BIN=/usr/local/bin/gvt-streamd
# GVT_STREAMD_SOCKET=/root/qemu_cmd/win10-gvt-streamd.sock
